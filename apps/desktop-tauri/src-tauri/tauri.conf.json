{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marlene",
  "version": "0.5.0",
  "identifier": "email.marlen.desktop.preview",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter @marlen/web exec vite --host 127.0.0.1 --mode tauri-preview",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Marlene",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../../desktop/resources/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
